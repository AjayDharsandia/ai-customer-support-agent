# Copy to server/.env and replace placeholders locally. Never commit real secrets.
NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/customer_support
# Generate at least 32 random bytes, for example with Node crypto.randomBytes(32).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
# Required for npm run test:integration; use separate test credentials/database.
MONGODB_TEST_URI=mongodb+srv://<test-user>:<test-password>@<cluster>.mongodb.net/customer_support_test

# Positive s/m/h/d durations: access <= 1h, refresh <= 30d and >= access.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
# Use secure for hosted HTTPS (__Host- cookie). Localhost mode permits loopback origins only.
AUTH_COOKIE_MODE=localhost
