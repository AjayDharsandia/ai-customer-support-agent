# Only build inputs enter the context; dependencies, tests, caches and metadata stay out.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!tsconfig.build.json
# Private and temporary files remain excluded inside allowed source trees.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_ed25519
**/credentials.json
**/secrets.json
**/service-account*.json
**/secrets/**
**/.npmrc
**/.netrc
**/.aws/**
**/.azure/**
**/.config/gcloud/**
**/.git/**
**/node_modules/**
**/dist/**
**/build/**
**/coverage/**
**/tmp/**
**/temp/**
**/.vite/**
**/.cache/**
**/*.log
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~
